# Copie para .env e preencha. Nunca faça commit do .env real.
# Os nomes abaixo devem bater com os *_env referenciados em config/databases.yml.

# --- notificações usadas em `defaults.notifications` (webhook Slack/Discord/genérico) ---
DEFAULT_WEBHOOK_URL=

# --- remote "r2-principal" (Cloudflare R2) ---
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- remote "s3-aws-generico" ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- banco: app-simples ---
APP_SIMPLES_PGPASSWORD=

# --- banco: app-critico ---
APP_CRITICO_PGPASSWORD=
APP_CRITICO_OCI_PAR_URL=
APP_CRITICO_TELEGRAM_BOT_TOKEN=
APP_CRITICO_TELEGRAM_CHAT_ID=
APP_CRITICO_EMAIL_TO=
APP_CRITICO_DISCORD_WEBHOOK_URL=

# --- SMTP compartilhado (usado pelo canal de e-mail do app-critico) ---
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=backups@seudominio.com

# --- banco: app-legado ---
APP_LEGADO_PGPASSWORD=
APP_LEGADO_NTFY_URL=https://ntfy.sh/seu-topico-privado
