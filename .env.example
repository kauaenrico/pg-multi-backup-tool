# Copie para .env e preencha. Nunca faça commit do .env real.
# Os nomes abaixo devem bater com os *_env referenciados em config/databases.yml.

# --- notificações (opcional) ---
DEFAULT_WEBHOOK_URL=
WEBHOOK_FORMAT=slack
# WEBHOOK_FORMAT=discord

# --- remote "r2-principal" (Cloudflare R2) ---
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- remote "s3-aws-generico" ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- banco: meire-decoracoes ---
MEIRE_PGPASSWORD=
MEIRE_OCI_PAR_URL=
MEIRE_WEBHOOK_URL=

# --- banco: outro-projeto ---
OUTRO_PGPASSWORD=
